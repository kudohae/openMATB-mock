@@ -135,6 +147,52 @@ class Track(AbstractPlugin):
                 self.log_performance("response_time", self._response_elapsed_ms(self._response_start))
                 self._response_start = None
 
+    # Korean adaptation: tracking by moving the mouse (web/mouse_tracking.js). Few calls to JavaScript per step.
+    def _mouse_tracking(self) -> Any:
+        if not IS_WEB:
+            return None
+        if self._tracking_js is None:
+            import js  # type: ignore[import-not-found]
+
+            self._tracking_js = getattr(js.window, "MouseTracking", None)
+        return self._tracking_js
+
+    def _set_mouse_wanted(self, wanted: bool) -> None:
+        tracking: Any = self._mouse_tracking()
+        if tracking is not None and wanted != self._mouse_wanted:
+            self._mouse_wanted = wanted
+            tracking.setWanted(wanted)
+
+    def _take_mouse_movement(self) -> bool:
+        tracking: Any = self._mouse_tracking()
+        if tracking is None:
+            return False
+        self._set_mouse_wanted(True)
+        moved: str = str(tracking.take())
+        if moved == "0,0":
+            return False
+        if moved == "lost":  # The pointer lock has just been lost (Esc, focus change)
+            self._pointer_lost += 1
+            self.logger.log_manual_entry(str(self._pointer_lost), key="pointerlock_lost")
+            return False
+        dx, dy = (float(v) for v in moved.split(","))
+        # Browser movements: y goes down. The generator moves the cursor by (x_input, -y_input)
+        self.x_input = dx * self.parameters["mousegain"]
+        self.y_input = dy * self.parameters["mousegain"]
+        return True
+
+    def _release_mouse_tracking(self) -> None:
+        if self.parameters["mousemove"]:
+            self._set_mouse_wanted(False)
+
+    def pause(self) -> None:
+        super().pause()
+        self._release_mouse_tracking()
