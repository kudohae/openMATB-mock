+
+    # Korean adaptation: pyglet's browser window maps keys with event.key, which gives Hangul jamo ("ㅂ" for Q)
+    # when a Korean input method is on, so the letter keys of the tasks did nothing. Map letters and digits with
+    # event.code (the physical key), whatever the input method.
+    try:
+        import pyglet.window.emscripten as _web_window
+        from pyglet.window import key as _key
+
+        _js_key_to_pyglet = _web_window.js_key_to_pyglet
+
+        def _code_symbol(code: str) -> int | None:
+            if code.startswith("Key") and len(code) == 4:
+                return getattr(_key, code[3], None)
+            if code.startswith("Digit") and len(code) == 6:
+                return getattr(_key, "_" + code[5], None)
+            return None
+
+        def _js_key_to_pyglet_by_code(event: Any) -> Any:
+            symbol, modifiers = _js_key_to_pyglet(event)
+            by_code: int | None = _code_symbol(str(event.code or ""))
+            return (by_code if by_code is not None else symbol), modifiers
+
+        _web_window.js_key_to_pyglet = _js_key_to_pyglet_by_code
+    except ImportError:  # Desktop pyglet 3: no browser window
+        pass
 else:
     from pyglet.gl import Config
     from pyglet.media import Player as AudioPlayer
