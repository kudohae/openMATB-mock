             self.vertex[f"feedback_line_{i}"].opacity = color[3]
         self.logger.record_state(self.name, "feedback_color", color)
 
+    def set_confirm_flash(self, on: bool) -> None:
+        if on == self.confirm_flash:
+            return
+        self.confirm_flash = on
+        self.vertex["confirm_bg"].color = (200, 238, 210) if on else C["BACKGROUND"][:3]
+        self.logger.record_state(self.name, "confirm_flash", on)
