diff --git a/includes/scenarios/korean/make_study.py b/includes/scenarios/korean/make_study.py
new file mode 100644
index 0000000..cae9678
--- /dev/null
+++ b/includes/scenarios/korean/make_study.py
@@ -0,0 +1,174 @@
+"""Generate study.txt (Korean study scenario) and phases.json (scoring windows, in scenario seconds).
+
+Task 1: single tracking (30 s practice, 120 s scored).
+Task 2: guided tutorial on the live task screen, 60 s combined practice, then a 10-minute block whose system
+monitoring events replicate the low-reliability block of Parasuraman, Molloy and Singh (1993) shipped with OpenMATB
+(16 malfunctions, 9 solved by the automation), with communications prompts and pump failures added.
+
+Scenario time stops while instructions/guide slides are shown, so the windows below are exact.
+"""
+
+import json
+from pathlib import Path
+
+HERE = Path(__file__).parent
+lines: list[str] = []
+
+
+def ts(sec: float) -> str:
+    sec = int(round(sec))
+    return f"{sec // 3600}:{sec % 3600 // 60:02d}:{sec % 60:02d}"
+
+
+def ev(sec: float, *parts: str) -> None:
+    lines.append(f"{ts(sec)};" + ";".join(parts))
+
+
+def note(text: str) -> None:
+    lines.append("")
+    lines.append(f"# {text}")
+
+
+def slides(sec: float, filename: str) -> None:
+    ev(sec, "instructions", "filename", f"korean/{filename}")
+    ev(sec, "instructions", "start")
+
+
+def guide(sec: float, filename: str, area: str, highlight: str = "none") -> None:
+    ev(sec, "guide", "area", area)
+    ev(sec, "guide", "highlight", highlight)
+    ev(sec, "guide", "filename", f"korean/{filename}")
+    ev(sec, "guide", "start")
+
+
+def sysmon_failure(sec: float, gauge: str, auto: bool, side: str | None = None) -> None:
+    ev(sec, "sysmon", "automaticsolver", str(auto))
+    if gauge.startswith("scales") and side is not None:
+        ev(sec, "sysmon", f"{gauge}-failure", side)
+    else:
+        ev(sec, "sysmon", f"{gauge}-failure", "True")
+
+
+def pump_failure(start: float, end: float, pump: int) -> None:
+    ev(start, "resman", f"pump-{pump}-state", "failure")
+    ev(end, "resman", f"pump-{pump}-state", "off")
+
+
+lines += [
+    "# Korean adaptation of OpenMATB for a selection study (2026). Generated by make_study.py: edit that file.",
+    "# Keys without a numeric keypad: sysmon 1-6, pumps Q W E R A S D F, communications Z X C V + B.",
+]
+note("Settings")
+ev(0, "system", "mousecontrol", "True")
+for i in range(1, 5):
+    ev(0, "sysmon", f"scales-{i}-name", str(i))
+    ev(0, "sysmon", f"scales-{i}-key", f"_{i}")
+ev(0, "sysmon", "lights-1-name", "5")
+ev(0, "sysmon", "lights-1-key", "_5")
+ev(0, "sysmon", "lights-2-name", "6")
+ev(0, "sysmon", "lights-2-key", "_6")
+ev(0, "sysmon", "automaticsolverdelay", "4000")  # As in Parasuraman et al. (1993) scenario
+ev(0, "sysmon", "feedbackduration", "1500")
+ev(0, "sysmon", "alerttimeout", "10000")
+for n, key in enumerate("QWERASDF", start=1):
+    ev(0, "resman", f"pump-{n}-key", key)
+for name, key in [("selectradioup", "Z"), ("selectradiodown", "X"), ("tunefrequencydown", "C"),
+                  ("tunefrequencyup", "V"), ("validateresponse", "B")]:
+    ev(0, "communications", f"keys-{name}", key)
+ev(0, "communications", "voiceidiom", "korean")
+ev(0, "communications", "voicegender", "tts")
+ev(0, "track", "cursorcolor", "#009900")
+
+# ---------------- Task 1: tracking only ----------------
+note("Task 1: tracking alone")
+slides(0, "01_welcome.txt")
+ev(0, "track", "start")
+A_PRACTICE, A_START, A_END = 0, 30, 150
+guide(A_START, "02_track_main.txt", "bottom", "topmid")
+ev(A_END, "track", "stop")
+
+# ---------------- Task 2: guided tutorial on the live screen ----------------
+T = A_END
+note("Task 2: tutorial")
+slides(T, "03_task2_intro.txt")
+for plugin in ("sysmon", "track", "communications", "resman"):
+    ev(T, plugin, "start")
+# Let every task draw itself for 1 s before the guides freeze the screen (a task paused before its first
+# update stays blank)
+T += 1
+for plugin in ("track", "communications", "resman"):
+    ev(T, plugin, "pause")
+guide(T, "04_overview.txt", "center")
+
+note("Tutorial: system monitoring alone (30 s)")
+guide(T, "05_sysmon.txt", "right", "topleft")
+# The automatic solver is one switch for the whole task: an automated failure must not overlap a manual one
+sysmon_failure(T + 3, "scales-2", False, "up")
+sysmon_failure(T + 14, "scales-4", True, "down")
+sysmon_failure(T + 19, "lights-1", False)
+T += 30
+ev(T, "sysmon", "pause")
+
+note("Tutorial: communications alone (45 s)")
+ev(T, "communications", "resume")
+guide(T, "06_comm.txt", "right", "bottomleft")
+ev(T + 1, "communications", "radioprompt", "own")
+ev(T + 22, "communications", "radioprompt", "other")
+T += 45
+ev(T, "communications", "pause")
+
+note("Tutorial: resources management alone (45 s)")
+ev(T, "resman", "resume")
+guide(T, "07_resman.txt", "top", "bottommid")
+pump_failure(T + 15, T + 30, 2)
+T += 45
+
+note("Tutorial: all tasks together (60 s, not scored)")
+for plugin in ("sysmon", "track", "communications"):
+    ev(T, plugin, "resume")
+guide(T, "08_all.txt", "center")
+sysmon_failure(T + 5, "scales-1", False, "down")
+ev(T + 9, "communications", "radioprompt", "own")
+sysmon_failure(T + 24, "lights-2", True)
+pump_failure(T + 26, T + 41, 3)
+ev(T + 33, "communications", "radioprompt", "other")
+sysmon_failure(T + 44, "scales-3", False, "up")
+T += 60
+
+# ---------------- Task 2: scored block (10 min) ----------------
+B_START = T
+note("Task 2: scored block (600 s)")
+guide(T, "09_main.txt", "center")
+# System monitoring: low-reliability block of Parasuraman et al. (1993), as in
+# includes/scenarios/Parasuraman_et_al_1993/low_reliability_block.txt (times, gauges, automation)
+PARASURAMAN = [
+    ("0:00:34", "scales-1", "down", True), ("0:00:59", "scales-3", "up", True),
+    ("0:01:42", "scales-2", "down", False), ("0:02:03", "scales-1", "up", True),
+    ("0:02:58", "scales-4", "down", False), ("0:03:26", "scales-2", "down", False),
+    ("0:04:04", "scales-1", "up", True), ("0:04:28", "lights-2", None, False),
+    ("0:05:38", "scales-4", "down", False), ("0:06:12", "scales-2", "up", False),
+    ("0:06:30", "lights-2", None, True), ("0:07:14", "scales-1", "down", True),
+    ("0:07:55", "scales-3", "up", True), ("0:08:17", "scales-1", "down", False),
+    ("0:08:55", "lights-1", None, False), ("0:09:31", "scales-4", "down", True),
+]
+for stamp, gauge, side, auto in PARASURAMAN:
+    h, m, s = (int(x) for x in stamp.split(":"))
+    sysmon_failure(B_START + h * 3600 + m * 60 + s, gauge, auto, side)
+# Communications: 10 own and 8 other prompts, not within 6 s of a malfunction
+for sec in (20, 78, 133, 190, 252, 300, 362, 418, 482, 545):
+    ev(B_START + sec, "communications", "radioprompt", "own")
+for sec in (48, 108, 160, 222, 330, 395, 455, 515):
+    ev(B_START + sec, "communications", "radioprompt", "other")
+# Resources management: four pump failures of 20 s
+for start, pump in ((88, 1), (205, 3), (322, 2), (447, 4)):
+    pump_failure(B_START + start, B_START + start + 20, pump)
+B_END = B_START + 600
+for plugin in ("sysmon", "track", "communications", "resman"):
+    ev(B_END, plugin, "stop")
+slides(B_END, "10_end.txt")
+
+
+PHASES = {"A_main": [A_START, A_END], "B_main": [B_START, B_END], "A_practice": [A_PRACTICE, A_START]}
+lines.insert(2, "# PHASES " + json.dumps(PHASES))  # Read by core/korean_score.py
+(HERE / "study.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")
+print(f"study.txt: {len(lines)} lines, task 1 {A_START}-{A_END} s, task 2 block {B_START}-{B_END} s")
