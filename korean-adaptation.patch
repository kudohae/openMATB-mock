diff --git a/includes/scenarios/korean/make_study.py b/includes/scenarios/korean/make_study.py
new file mode 100644
index 0000000..655d9cb
--- /dev/null
+++ b/includes/scenarios/korean/make_study.py
@@ -0,0 +1,210 @@
+"""Generate study.txt (Korean study scenario) with its scoring windows (PHASES line, scenario seconds).
+
+Task 1 (like the multitasking subtest of the Air Force pilot aptitude test K-PAT): tracking and communications at
+the same time, no automation. Tutorial, then 150 s scored.
+Task 2: the four tasks. Guided tutorial on the live task screen, 60 s combined practice, then a 5-minute block whose
+system monitoring events follow the low-reliability block of Parasuraman, Molloy and Singh (1993) shipped with
+OpenMATB (automation that misses half of the malfunctions), with communications prompts and pump failures.
+
+Scenario time stops while instructions/guide slides are shown, so the windows are exact. The communications
+tutorial step ends at the first correct response (gate plugin): the scenario then jumps to the end of the step.
+"""
+
+import json
+from pathlib import Path
+
+HERE = Path(__file__).parent
+lines: list[str] = []
+
+
+def ts(sec: float) -> str:
+    sec = int(round(sec))
+    return f"{sec // 3600}:{sec % 3600 // 60:02d}:{sec % 60:02d}"
+
+
+def ev(sec: float, *parts: str) -> None:
+    lines.append(f"{ts(sec)};" + ";".join(parts))
+
+
+def note(text: str) -> None:
+    lines.append("")
+    lines.append(f"# {text}")
+
+
+def slides(sec: float, filename: str) -> None:
+    ev(sec, "instructions", "filename", f"korean/{filename}")
+    ev(sec, "instructions", "start")
+
+
+def guide(sec: float, filename: str, area: str, highlight: str = "none", box: str = "0,0,1,1") -> None:
+    ev(sec, "guide", "area", area)
+    ev(sec, "guide", "highlight", highlight)
+    ev(sec, "guide", "highlightbox", box)
+    ev(sec, "guide", "filename", f"korean/{filename}")
+    ev(sec, "guide", "start")
+
+
+def sysmon_failure(sec: float, gauge: str, auto: bool, side: str | None = None) -> None:
+    ev(sec, "sysmon", "automaticsolver", str(auto))
+    if gauge.startswith("scales") and side is not None:
+        ev(sec, "sysmon", f"{gauge}-failure", side)
+    else:
+        ev(sec, "sysmon", f"{gauge}-failure", "True")
+
+
+def pump_failure(start: float, end: float, pump: int) -> None:
+    ev(start, "resman", f"pump-{pump}-state", "failure")
+    ev(end, "resman", f"pump-{pump}-state", "off")
+
+
+lines += [
+    "# Korean adaptation of OpenMATB for a selection study (2026). Generated by make_study.py: edit that file.",
+    "# Keys without a numeric keypad: sysmon 1-6, pumps Q W E R A S D F, communications arrows + Enter, tracking by mouse.",
+]
+note("Settings")
+for i in range(1, 5):
+    ev(0, "sysmon", f"scales-{i}-name", str(i))
+    ev(0, "sysmon", f"scales-{i}-key", f"_{i}")
+ev(0, "sysmon", "lights-1-name", "5")
+ev(0, "sysmon", "lights-1-key", "_5")
+ev(0, "sysmon", "lights-2-name", "6")
+ev(0, "sysmon", "lights-2-key", "_6")
+ev(0, "sysmon", "automaticsolverdelay", "4000")  # As in Parasuraman et al. (1993) scenario
+ev(0, "sysmon", "feedbackduration", "1500")
+ev(0, "sysmon", "alerttimeout", "10000")
+for n, key in enumerate("QWERASDF", start=1):
+    ev(0, "resman", f"pump-{n}-key", key)
+# Communications: default OpenMATB keys (arrows to select the radio and tune, Enter to validate)
+ev(0, "communications", "voiceidiom", "korean")
+ev(0, "communications", "voicegender", "tts")
+ev(0, "communications", "confirmflash", "True")  # Light-green receipt after every Enter, right or wrong
+ev(0, "track", "cursorcolor", "#009900")
+ev(0, "track", "mousemove", "True")  # The cursor follows the mouse movements (pointer hidden)
+
+
+def comm_tutorial_feedback(sec: float, on: bool) -> None:
+    ev(sec, "communications", "feedbacks-positive-active", str(on))
+    ev(sec, "communications", "feedbacks-negative-active", str(on))
+
+
+# ---------------- Task 1: tracking + communications (like the multitasking subtest of the K-PAT) ----------------
+note("Task 1: tutorial")
+slides(0, "01_welcome.txt")
+ev(0, "track", "start")
+ev(0, "communications", "start")
+T = 1  # Let the tasks draw themselves before the guides freeze the screen
+ev(T, "communications", "pause")
+guide(T, "A1_track.txt", "bottom", "topmid")
+T += 20
+ev(T, "track", "pause")
+
+note("Tutorial: communications alone, the step ends with the first correct response (plugins/gate.py)")
+COMM_STEP = 60
+ev(T, "communications", "maxresponsedelay", str((COMM_STEP - 5) * 1000))
+comm_tutorial_feedback(T, True)
+guide(T, "A2_comm.txt", "right", "bottomleft")
+ev(T, "communications", "resume")
+ev(T, "communications", "radioprompt", "own")
+ev(T, "gate", "skipto", str(T + COMM_STEP))
+ev(T, "gate", "start")
+T += COMM_STEP
+ev(T, "gate", "stop")  # Already stopped when passed: the scenario checker requires a stop command
+ev(T, "communications", "maxresponsedelay", "20000")
+
+note("Tutorial: another callsign (no response)")
+guide(T, "A3_comm_other.txt", "right", "bottomleft")
+ev(T + 1, "communications", "radioprompt", "other")
+T += 20  # Each word is spoken separately: a prompt lasts about 15 s
+
+note("Tutorial: tracking and communications together (40 s)")
+ev(T, "track", "resume")
+guide(T, "A4_both.txt", "center")
+ev(T + 6, "communications", "radioprompt", "own")
+T += 40
+comm_tutorial_feedback(T, False)
+
+A_START = T
+note("Task 1: scored block (150 s)")
+guide(T, "A5_main.txt", "center")
+# A prompt lasts about 15 s, then 20 s to respond: a new prompt never cuts the previous one
+for sec in (8, 38, 68, 104):
+    ev(A_START + sec, "communications", "radioprompt", "own")
+for sec in (26, 56, 88, 125):
+    ev(A_START + sec, "communications", "radioprompt", "other")
+A_END = A_START + 150
+
+# ---------------- Task 2: four tasks, guided tutorial on the live screen ----------------
+T = A_END
+note("Task 2: tutorial")
+ev(T, "track", "pause")
+ev(T, "communications", "pause")
+slides(T, "B0_intro.txt")
+ev(T, "sysmon", "start")
+ev(T, "resman", "start")
+T += 1
+ev(T, "resman", "pause")
+guide(T, "B1_overview.txt", "center")
+
+note("Tutorial: system monitoring alone (30 s)")
+guide(T, "B2_sysmon.txt", "right", "topleft")
+# The automatic solver is one switch for the whole task: an automated failure must not overlap a manual one
+sysmon_failure(T + 3, "scales-2", False, "up")
+sysmon_failure(T + 14, "scales-4", True, "down")
+sysmon_failure(T + 19, "lights-1", False)
+T += 30
+ev(T, "sysmon", "pause")
+
+note("Tutorial: resources management alone (45 s)")
+ev(T, "resman", "resume")
+guide(T, "B3_resman_goal.txt", "top", "bottommid", "0.11,0.43,0.71,0.40")
+guide(T, "B4_resman_pumps.txt", "top", "bottommid", "0.07,0.45,0.32,0.15")
+guide(T, "B5_resman_more.txt", "top", "bottommid")
+pump_failure(T + 15, T + 30, 2)
+T += 45
+
+note("Tutorial: all tasks together (60 s, not scored)")
+for plugin in ("sysmon", "track", "communications"):
+    ev(T, plugin, "resume")
+guide(T, "B6_all.txt", "center")
+sysmon_failure(T + 5, "scales-1", False, "down")
+ev(T + 9, "communications", "radioprompt", "own")
+sysmon_failure(T + 24, "lights-2", True)
+pump_failure(T + 26, T + 41, 3)
+ev(T + 33, "communications", "radioprompt", "other")
+sysmon_failure(T + 44, "scales-3", False, "up")
+T += 60
+
+# ---------------- Task 2: scored block (5 min) ----------------
+B_START = T
+note("Task 2: scored block (300 s)")
+guide(T, "B7_main.txt", "center")
+# System monitoring: the first 12 malfunctions of the low-reliability block of Parasuraman, Molloy and Singh (1993)
+# shipped with OpenMATB (includes/scenarios/Parasuraman_et_al_1993/low_reliability_block.txt), same gauges and
+# automation (6 solved by the automation, 6 missed by it), on a 5-minute time line. At least 18 s apart, so that a
+# manual failure (10 s timeout) never overlaps an automated one.
+SYSMON = [
+    (15, "scales-1", "down", True), (38, "scales-3", "up", True), (60, "scales-2", "down", False),
+    (82, "scales-1", "up", True), (101, "scales-4", "down", False), (125, "scales-2", "down", False),
+    (148, "scales-1", "up", True), (170, "lights-2", None, False), (193, "scales-4", "down", False),
+    (218, "scales-2", "up", False), (244, "lights-2", None, True), (270, "scales-1", "down", True),
+]
+for sec, gauge, side, auto in SYSMON:
+    sysmon_failure(B_START + sec, gauge, auto, side)
+# Communications: 8 own and 4 other prompts, not within 6 s of a malfunction
+for sec in (8, 46, 90, 116, 156, 201, 226, 262):
+    ev(B_START + sec, "communications", "radioprompt", "own")
+for sec in (30, 72, 138, 182):
+    ev(B_START + sec, "communications", "radioprompt", "other")
+# Resources management: three pump failures of 20 s
+for start, pump in ((50, 1), (150, 3), (235, 2)):
+    pump_failure(B_START + start, B_START + start + 20, pump)
+B_END = B_START + 300
+for plugin in ("sysmon", "track", "communications", "resman"):
+    ev(B_END, plugin, "stop")
+slides(B_END, "99_end.txt")
+
+
+PHASES = {"A_main": [A_START, A_END], "B_main": [B_START, B_END]}
+lines.insert(2, "# PHASES " + json.dumps(PHASES))  # Read by core/korean_score.py
+(HERE / "study.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")
+print(f"study.txt: {len(lines)} lines, task 1 {A_START}-{A_END} s, task 2 block {B_START}-{B_END} s")
