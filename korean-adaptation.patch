diff --git a/core/korean_score.py b/core/korean_score.py
new file mode 100644
index 0000000..751cfee
--- /dev/null
+++ b/core/korean_score.py
@@ -0,0 +1,141 @@
+# Copyright 2023-2026, by Julien Cegarra & Benoît Valéry. All rights reserved.
+# Institut National Universitaire Champollion (Albi, France).
+# License : CeCILL, version 2.1 (see the LICENSE file)
+#
+# Korean adaptation (2026): summary scores of the study session, shown as a result code to paste in a survey.
+
+"""Score a session of includes/scenarios/korean/study.txt.
+
+The scoring windows (scenario seconds) are read from the "# PHASES {...}" line of the scenario. Measures:
+- Task 1 (A_main, tracking alone) and task 2 (B_main): tracking, % of updates with the cursor in the target, and the
+  RMS distance to the center (pixels, with the window height to normalise it)
+- System monitoring (B_main): misses of the automation handled by the participant (HIT by a human), misses,
+  false alarms, mean response time (ms)
+- Communications (B_main): counts of each signal detection value and mean response time of the hits (ms)
+- Resources management (B_main): % of time tanks A and B are within tolerance
+
+result_code() returns "OM1-" + base64 of {"j": json, "c": checksum}: web/decode.html turns codes into a table.
+"""
+
+from __future__ import annotations
+
+import base64
+import csv
+import json
+import math
+from pathlib import Path
+from statistics import mean
+from typing import Any
+
+SCENARIO: Path = Path("includes/scenarios/korean/study.txt")
+CODE_PREFIX: str = "OM1-"
+
+
+def read_phases(scenario: Path = SCENARIO) -> dict[str, list[float]]:
+    for line in scenario.read_text(encoding="utf-8").splitlines():
+        if line.startswith("# PHASES "):
+            return json.loads(line[len("# PHASES ") :])
+    raise ValueError("No PHASES line in the scenario")
+
+
+def _float(value: str) -> float:
+    try:
+        return float(value)
+    except ValueError:
+        return float("nan")
+
+
+def _r(x: float | None, digits: int = 2) -> float | None:
+    return None if x is None or (isinstance(x, float) and math.isnan(x)) else round(x, digits)
+
+
+def _mean(values: list[float]) -> float | None:
+    values = [v for v in values if not math.isnan(v)]
+    return mean(values) if values else None
+
+
+def score_rows(rows: list[dict[str, str]], phases: dict[str, list[float]]) -> dict[str, Any]:
+    def window(name: str) -> list[dict[str, str]]:
+        start, end = phases[name]
+        return [r for r in rows if start <= _float(r["scenario_time"]) < end]
+
+    out: dict[str, Any] = {}
+    env: dict[str, str] = {r["address"] or r["type"]: r["value"] for r in rows if r["type"] in ("browser", "os")}
+    out["browser"] = env.get("browser", "")[:40]
+    manual: list[str] = [r["value"] for r in rows if r["type"] == "manual"]
+    out["voice"] = next((m.split(": ", 1)[1] for m in manual if m.startswith("Korean voice: ")), "")[:40]
+    sizes = [r["value"].split("x") for r in rows if r["type"] == "window"]  # "1366x768"
+    out["win_h"] = _r(_float(sizes[-1][-1]), 0) if sizes else None
+
+    for phase, prefix in (("A_main", "A"), ("B_main", "B")):
+        perf = [r for r in window(phase) if r["type"] == "performance" and r["module"] == "track"]
+        inside = [r["value"] == "True" for r in perf if r["address"] == "cursor_in_target" and r["value"] in ("True", "False")]
+        dev = [_float(r["value"]) for r in perf if r["address"] == "center_deviation"]
+        dev = [d for d in dev if not math.isnan(d)]
+        out[f"{prefix}_trk_in"] = _r(100 * sum(inside) / len(inside)) if inside else None
+        out[f"{prefix}_trk_rms"] = _r(math.sqrt(sum(d * d for d in dev) / len(dev))) if dev else None
+
+    block = window("B_main")
+
+    # System monitoring: rows come by groups (name, signal_detection, response_time, resolved_by)
+    sys_rows = [r for r in block if r["type"] == "performance" and r["module"] == "sysmon"]
+    events: list[dict[str, str]] = []
+    for r in sys_rows:
+        if r["address"] == "name" or not events:
+            events.append({})
+        events[-1][r["address"]] = r["value"]
+    hits = [e for e in events if e.get("signal_detection") == "HIT" and e.get("resolved_by") == "human"]
+    out["B_sm_hit"] = len(hits)
+    out["B_sm_auto"] = sum(1 for e in events if e.get("signal_detection") == "HIT" and e.get("resolved_by") != "human")
+    out["B_sm_miss"] = sum(1 for e in events if e.get("signal_detection") == "MISS")
+    out["B_sm_fa"] = sum(1 for e in events if e.get("signal_detection") == "FA")
+    out["B_sm_rt"] = _r(_mean([_float(e.get("response_time", "nan")) for e in hits]), 0)
+
+    # Communications: one sdt_value and one response_time per response or miss
+    com = [r for r in block if r["type"] == "performance" and r["module"] == "communications"]
+    sdt = [r["value"] for r in com if r["address"] == "sdt_value"]
+    rts = [r["value"] for r in com if r["address"] == "response_time"]
+    for value in ("HIT", "MISS", "FA", "BAD_RADIO", "BAD_FREQ", "BAD_RADIO_FREQ"):
+        out[f"B_cm_{value.lower()}"] = sdt.count(value)
+    out["B_cm_rt"] = _r(_mean([_float(rt) for s, rt in zip(sdt, rts) if s == "HIT"]), 0)
+
+    # Resources management
+    res = [r for r in block if r["type"] == "performance" and r["module"] == "resman"]
+    for tank in ("a", "b"):
+        flags = [r["value"] == "True" for r in res if r["address"] == f"{tank}_in_tolerance" and r["value"] in ("True", "False")]
+        out[f"B_rm_{tank}"] = _r(100 * sum(flags) / len(flags)) if flags else None
+    both = [x for x in (out["B_rm_a"], out["B_rm_b"]) if x is not None]
+    out["B_rm"] = _r(mean(both)) if both else None
+
+    # Pauses of the page (tab change) and freezes during the scored windows
+    out["hidden"] = sum(1 for r in rows if r["type"] == "visibility" and r["value"] in ("hidden", "False"))
+    out["freeze_ms"] = _r(sum(_float(r["value"]) for r in rows if r["type"] == "freeze"), 0)
+    return out
+
+
+def score_file(path: str | Path, scenario: Path = SCENARIO) -> dict[str, Any]:
+    with open(path, encoding="utf-8", newline="") as f:
+        rows = list(csv.DictReader(f))
+    result = score_rows(rows, read_phases(scenario))
+    result["file"] = Path(path).name
+    return result
+
+
+def fnv1a(text: str) -> str:
+    h = 0x811C9DC5
+    for ch in text:
+        h ^= ord(ch)
+        h = (h * 0x01000193) & 0xFFFFFFFF
+    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
+    out = ""
+    while True:
+        h, r = divmod(h, 36)
+        out = digits[r] + out
+        if h == 0:
+            return out
+
+
+def result_code(result: dict[str, Any]) -> str:
+    text = json.dumps(result, ensure_ascii=True, separators=(",", ":"))
+    payload = json.dumps({"j": text, "c": fnv1a(text)}, ensure_ascii=True, separators=(",", ":"))
+    return CODE_PREFIX + base64.b64encode(payload.encode("ascii")).decode("ascii")
diff --git a/core/korean_tts.py b/core/korean_tts.py
new file mode 100644
index 0000000..14885d7
--- /dev/null
+++ b/core/korean_tts.py
@@ -0,0 +1,99 @@
+# Copyright 2023-2026, by Julien Cegarra & Benoît Valéry. All rights reserved.
+# Institut National Universitaire Champollion (Albi, France).
+# License : CeCILL, version 2.1 (see the LICENSE file)
+#
+# Korean adaptation (2026): communications prompts read in Korean by the browser speech synthesis.
+
+"""Korean voice for the communications task (browser only).
+
+The recorded voices of OpenMATB are English or French. With voiceidiom=korean, the prompt is read by the browser
+speech synthesis (web/korean_tts.js) with a Korean voice. TTSPlayer has the subset of the player API used by the
+communications plugin: the prompt is over when `source` becomes None (so the response timer starts at the end of the
+spoken message, as with the recorded voices).
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pyglet.clock
+
+from core.platform import IS_WEB
+
+KOREAN_IDIOM: str = "korean"
+SPEECH_RATE: float = 1.0
+LEAD_SILENCE: float = 2.0  # The recorded prompts start with 20 "empty" samples of 0.1 s
+
+LETTERS: dict[str, str] = dict(
+    zip(
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
+        "에이 비 씨 디 이 에프 지 에이치 아이 제이 케이 엘 엠 엔 오 피 큐 알 에스 티 유 브이 더블유 엑스 와이 제트".split(),
+    )
+)
+DIGITS: dict[str, str] = dict(zip("0123456789", "공 하나 둘 삼 넷 오 여섯 칠 팔 아홉".split()))
+RADIOS: dict[str, str] = {"NAV_1": "내브 원", "NAV_2": "내브 투", "COM_1": "컴 원", "COM_2": "컴 투"}
+
+
+def say_chars(text: str) -> str:
+    return " ".join(LETTERS.get(c.upper(), DIGITS.get(c, c)) for c in text if not c.isspace())
+
+
+def prompt_text(callsign: str, radio_name: str, freq: float) -> str:
+    """e.g. "에이 비 씨 하나 둘 삼, 에이 비 씨 하나 둘 삼. 무전기 내브 원, 주파수 하나 둘 여섯 점 오." """
+    call: str = say_chars(callsign)
+    digits: str = " ".join("점" if c == "." else DIGITS.get(c, c) for c in str(freq))
+    return f"{call}, {call}. 무전기 {RADIOS.get(radio_name.upper(), radio_name)}, 주파수 {digits}."
+
+
+def _tts() -> Any:
+    import js  # type: ignore[import-not-found]
+
+    return getattr(js.window, "KoreanTTS", None)
+
+
+def voice_name() -> str:
+    if not IS_WEB or _tts() is None:
+        return ""
+    return str(_tts().voiceName())
+
+
+class TTSPlayer:
+    def __init__(self, text: str, delay: float = LEAD_SILENCE) -> None:
+        self.text: str = text
+        self.delay: float = delay
+        self.volume: float = 1.0
+        self._id: Any = None
+        self._playing: bool = False
+        self._finished: bool = not IS_WEB or _tts() is None  # No speech synthesis: the prompt is over at once
+
+    @property
+    def source(self) -> Any:
+        if self._finished:
+            return None
+        if self._id is not None and bool(_tts().isDone(self._id)):
+            self._finished = True
+            self._playing = False
+            return None
+        return self
+
+    def play(self) -> None:
+        if self._finished or self._playing:
+            return
+        self._playing = True
+        pyglet.clock.schedule_once(self._speak, self.delay)
+
+    def _speak(self, dt: float) -> None:
+        if self._playing and not self._finished:
+            self._id = _tts().speak(self.text, SPEECH_RATE)
+
+    def pause(self) -> None:
+        # Like the recorded prompts, a paused message is read again from its beginning
+        self._playing = False
+        pyglet.clock.unschedule(self._speak)
+        if self._id is not None:
+            self._id = None
+            _tts().cancel()
+
+    def delete(self) -> None:
+        self.pause()
+        self._finished = True
